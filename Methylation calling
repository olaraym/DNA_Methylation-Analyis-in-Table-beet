#!/usr/bin/bash

# Pacbio sequences and Enzymatic methyl sequences were obtained from ICB, BOKU.
# After these files where obtained, the Pacbio Seq was firts analysed using the procedure below:

# Methylation analysis of the PacBio Sequence 
# Raw Pacbio Hifi reads in BAM format were first filtered to collect only double-stranded reads 
# for downstream processes. Double-starnded reads were collected because at the time of this analysis, 
# the packages available couldn't work with single-stranded reads. This was done using the line of code below; 
   
samtools view -d "fi" -b TableBeet.Kinetics.CCS.hifi.bam > TableBeet.Kinetics.CCS.hifi.ds.bam

# Next, I applied the Primrose software (Version 1.3.0) to the retrieved double-stranded Hifi read data 
to predict the 5mC probabilities using their respective kinetic information with the line of code below;

primrose --min-passes 3 TKC_hifi.ds.bam TKC.hifi.ds.out.bam -j 20

# Next, the obtained HiFi reads containing 5mC tags (provided in an unaligned BAM format) were aligned to a 
tablebeet reference using pbmm2 version 1.12.0 (Pacific Bioscience, 2023) Using the line of code below;

pbmm2 align TB-assembly.posscaf.fa TKC.hifi.ds.out.bam TKC.hifi.ds.out.align.bam -j 30

# Then the indexed bam files were used to obtain Pileup scores for 5mC across CpG sites using the Pb_CpG_tool 
(version 2.3.1) with the line of code below;

aligned_bam_to_cpg_scores -b hifi.sort.bam -f TB-assembly.posscaf.fa -o pb -p count -m reference -t 30

# Then, I collected methylation information from the first 9 scaffolds, which is known to contain the most important 
sequences of the table beet genome, with coverage of ≥ 4 and methylation probability ≥20% using the line of code below;

awk '$1 ~ /^scaffold_[1-9]$/' pb.combined.reference.mincov4.bed | awk '$5>=20 && $6>=4' | awk	'{OFS="\t"} {print $1"\t"$2"\t"$3"\t"$4"\t"$6}' > mCG_pb1-9.bed


# Methylation analysis of the Pacbio_seq data Using the CCS_meth pipeline.
# The CCS_meth pipeline used in this study is based on a deep learning approach and was designed to detect methylation 
# in the 5mCpG context from circular consensus sequences (Hifi reads), it uses an attention-based bidirectional Gated Recurrent Unit (GRU) 
# networks to predict DNA methylation states of cytosine in Hifi reads (Peng N. et al., 2022). The approach also consisted of a series of 
# steps which is detailed in Figure 7B. and in the following lines of codes below;

# Modification probability calling from the aligned PacBio reads using the code below;

ccsmeth call_mods --input hifi.pbmm2.bam --ref ../TB-assembly.posscaf.fa \
--model_file model_ccsmeth_5mCpG_call_mods_attbigru2s_b21.v1.ckpt \
--output ./new/cmod --threads 50 --threads_call 10 --model_type attbigru2s \
--rm_per_readsite --mode align --modbam modbam --motif CG

# Extraction of modification probabilities for CG methylation context using the line of code below;

ccsmeth call_freqt --input_path /path/to/cmod.per_redsite.tsv \ 
	--result_file /path/to/new_CG_ccsmeth --bed –sort\ 
	--prob_cf 0.0 --refsites_only \
	--motifs CG --mod_loc 0 --ref /path/to/TB-assembly.posscaf.fa \
	--contigs --threads 30

# Next, the command line below using awk was used for extracting and sorting the necessary columns 
# and information, see the line of code below;
awk '{OFS="\t"} {print $1"\t"$2"\t"$3"\t"$6"\t"$11"\t"$10}' new_CG_ccsmeth | awk '$4=="+"{print $1"\t"$2"\t"$3"\t"$4"\t"$5"\t"$6}$4==\
"-"{print $1"\t"$2-1"\t"$3-1"\t"$4"\t"$5"\t"$6}' | sort -u -k1,1 -k2,2n | awk '$6>=4' > mCG_ccs.bed


# Methylation Calling and Analysis from the EM_seq dataset
# To analyze the EM-seq data, I utilized the Bisulfite Bolt (Bsbolt) pipeline. 
# This pipeline is a Python-based program and was designed to utilize forked versions of Burrow Wheelers Alignment (BWA) 
# for read alignment, and it engages the following steps of alignment, sorting, and indexing, and the actual methylation calling (Farrell et al., 2021). 
# The full description of all the necessary steps is described in Figure 8 and the lines of codes below;

# Quality check was first performed on the paired-end read using the Fastqc function in bash, then adaptors were removed using trim_galore in the line of code as; 

trim_galore -j 30 -e 0.1 -q 20 -O 1 -a -illumina ../Em_seq/Em_seq_R1 ../Em_seq/Em_seq_R2

# Indexing the reference genome

python3 -m bsbolt Index -G /path/to/ TB-assembly.posscaf.fa -DB /path/to/output

# Read alignment of the obtained trimmed Em_seq read fastq files to the indexed reference

python3 -m bsbolt Align -DB path/to/DB_output -F1 input.fastq -F1 input.fastq -O ./output/Em_meth -t 20

# Note: After filtering and alignment of the reads to the reference genome, the mapped reads accounted for approximately 99x coverage of the genome.

# Pre-processing of the aligned output file using default settings of samtools with options fixmate, 
# sort, markdup, and index to prepare the reads for duplicate removal. The reads were sorted by coordinate, 
# duplicates were removed and reads were indexed respectively. 

# Then the methylation probabilities of cytosine position were called using the code below

python3 -m bsbolt CallMethylation -I Em_dup.bam -O wgbs_out -DB ../path/to/DB_output -t 20 -verbose > Em_meth_stat

